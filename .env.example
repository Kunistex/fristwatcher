APP_NAME=Fristenwächter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fristwatcher.example.ch

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH
APP_TIMEZONE=Europe/Zurich

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fristwatcher
DB_USERNAME=fristwatcher
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="fristen@example.ch"
MAIL_FROM_NAME="${APP_NAME}"

# Registrierung nur offen, solange noch kein Konto existiert.
# Auf true setzen, um weitere Konten zuzulassen.
FRISTWATCHER_OPEN_REGISTRATION=false
FRISTWATCHER_REMINDER_HOUR=7

# Web-Push: erzeugen mit `php artisan webpush:vapid`
VAPID_SUBJECT="mailto:fristen@example.ch"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
